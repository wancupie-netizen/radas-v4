# Set these in .env.local and Vercel. Never commit real credentials.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Local: http://localhost:3000. Production: your actual HTTPS domain.
APP_URL=http://localhost:3000
# Reserved for later phases. Never prefix secret keys with NEXT_PUBLIC_.
NEXABOT_API_KEY=
SUPABASE_SECRET_KEY=
