# Set these in .env.local and Vercel. Never commit real credentials.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Local: http://localhost:3000. Production: your actual HTTPS domain.
APP_URL=http://localhost:3000
# Server secrets only. Never prefix these keys with NEXT_PUBLIC_.
NEXABOT_API_KEY=
SUPABASE_SECRET_KEY=
# Phase 06: keep false until migration and local checks pass. Never NEXT_PUBLIC_.
RADAS_GENERATION_ENABLED=false
# Phase 10: enable only after SQL verification; development auto-cleanup every 5 minutes.
RADAS_CLEANUP_ENABLED=false
# Production scheduler credential (32+ random characters). Never NEXT_PUBLIC_.
CRON_SECRET=
